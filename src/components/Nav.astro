---
import { nav, person } from '../data/site';
import { url } from '../lib/url';

interface Props {
  current?: string;
}

const { current } = Astro.props;
const isHome = Astro.url.pathname === url('/');
// on case-study pages the section links point back to the home page
const href = (id: string) => (isHome ? `#${id}` : `${url('/')}#${id}`);
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="monogram" href={url('/')} aria-label={`${person.name} — home`}>DK</a>

    <nav class="nav__links" aria-label="Sections">
      {
        nav.map((item) => (
          <a class="nav__link" href={href(item.id)} data-nav={item.id} aria-current={current === item.id ? 'true' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme" aria-pressed="false">
        <svg class="icon" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M10 1.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
        </svg>
      </button>
      <a class="btn btn--primary btn--m nav__cv" href={url(`/${person.cv}`)} download>
        Download CV <span class="arrow arrow--d" aria-hidden="true">↓</span>
      </a>
      <button class="menu-btn nav__menu" type="button" data-menu-open aria-label="Open menu" aria-expanded="false" aria-controls="menu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div class="progress" aria-hidden="true"></div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="wrap menu__top">
    <a class="monogram" href={url('/')} aria-label={`${person.name} — home`}>DK</a>
    <div class="nav__actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to light theme" aria-pressed="false">
        <svg class="icon" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M10 1.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
        </svg>
      </button>
      <button class="menu-btn" type="button" data-menu-close aria-label="Close menu">
        <svg class="icon" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" fill="none"></path>
        </svg>
      </button>
    </div>
  </div>
  <nav class="wrap menu__items" aria-label="Menu">
    {
      nav.map((item, i) => (
        <a class="menu__item" href={href(item.id)} data-nav={item.id} style={`--i:${i}`}>
          <small>{String(i + 1).padStart(2, '0')}</small>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="wrap menu__foot">
    <a class="btn btn--primary" href={url(`/${person.cv}`)} download>
      Download CV <span class="arrow arrow--d" aria-hidden="true">↓</span>
    </a>
    <a class="text-link" href={person.links.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
    <a class="text-link" href={person.links.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
  </div>
</div>
