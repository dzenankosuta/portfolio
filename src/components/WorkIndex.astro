---
import { getImage } from 'astro:assets';
import { projects, chapters, isMobile, isWeb } from '../data/projects';
import { img, hasImg } from '../lib/images';
import { projectUrl } from '../lib/url';

// preview = the project's first browser capture, otherwise its first card image
const rows = await Promise.all(
  projects.map(async (p) => {
    const media = p.card.find((m) => m.kind === 'browser') ?? p.card[0];
    const preview = await getImage({ src: img(p.slug, media.image), width: 640, format: 'webp' });
    const thumb = hasImg(p.slug, 'icon') ? await getImage({ src: img(p.slug, 'icon'), width: 104, format: 'webp' }) : null;
    return { p, preview: preview.src, thumb: thumb?.src };
  }),
);
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="wrap grid-lines">
    <div class="work__head">
      <h2 class="t-h2" id="work-title">Work</h2>
      <p class="t-label work__count" data-count-label aria-live="polite">{projects.length} independent products built &amp; shipped</p>
    </div>

    <div class="filters" role="toolbar" aria-label="Filter projects">
      <button class="tab" type="button" data-filter="all" aria-pressed="true">All</button>
      {
        (Object.keys(chapters) as (keyof typeof chapters)[]).map((c) => (
          <button class="tab" type="button" data-filter={c} aria-pressed="false">
            {chapters[c].label}
          </button>
        ))
      }
      <span class="filters__divider" aria-hidden="true"></span>
      <button class="tab tab--chip" type="button" data-platform="mobile" aria-pressed="false">Mobile</button>
      <button class="tab tab--chip" type="button" data-platform="web" aria-pressed="false">Web</button>
    </div>

    <ol class="index">
      {
        rows.map(({ p, preview, thumb }) => (
          <li data-chapter={p.chapter} data-mobile={isMobile(p) ? '1' : undefined} data-web={isWeb(p) ? '1' : undefined}>
            <a class="index-row" href={projectUrl(p.slug)} data-preview={preview}>
              {thumb && <img class="index-row__thumb" src={thumb} alt="" width="52" height="52" loading="lazy" decoding="async" />}
              <span class="index-row__idx">{p.index}</span>
              <span class="index-row__name">{p.name}</span>
              <span class="index-row__chapter">{chapters[p.chapter].label}</span>
              <span class="index-row__type">{p.type}</span>
              <span class="index-row__year">{p.year}</span>
              <span class="index-row__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
