---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/amiri/arabic-400.css';
import '../styles/global.scss';

import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import monoLatinExt from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-ext-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { person, meta } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** absolute or root-relative image URL for Open Graph */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  chapter?: string;
  current?: string;
}

const {
  title = meta.title,
  description = meta.description,
  image = url('/og.png'),
  imageAlt = `${person.name} — ${person.roleLong}`,
  type = 'website',
  jsonLd,
  chapter,
  current,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en" data-chapter={chapter}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={person.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0c0c0b" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        try {
          if (localStorage.getItem('theme') === 'paper') d.dataset.theme = 'paper';
        } catch {}
        if (d.dataset.theme === 'paper') {
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#f2efe8');
        }
      })();
    </script>

    {ld.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <div class="preview" aria-hidden="true"><img alt="" decoding="async" /></div>
    <p class="toast" role="status" aria-live="polite"></p>
    <button class="to-top" type="button" data-top aria-label="Back to top">
      <svg class="icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16V4M4.5 9.5 10 4l5.5 5.5" stroke="currentColor" stroke-width="2" fill="none"></path></svg>
    </button>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
